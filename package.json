{
  "name": "omni-notice-sigma-notification-widget",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/style.css",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --config vite.lib.config.ts && tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist/types",
    "build:demo": "tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "react-error-boundary": ">=4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^4.3.9"
  }
}
